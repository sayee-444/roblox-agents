-- A world whose River and Lake have no `banks`, and heights recorded from it on plugin 0.39.0, before
-- Valley Sides existed. Such a world must keep these heights exactly, so that older worlds regenerate
-- the same. Each sample is { x, z, height, mesa parameter, sand distance, water level }.

local shipped = require("../src/world/plan")

local function clone(v)
	if type(v) ~= "table" then
		return v
	end
	local c = {}
	for k, x in pairs(v) do
		c[k] = clone(x)
	end
	return c
end

local function plan()
	local p = clone(shipped)
	p.floorY = 0
	p.rockUnder = 8
	local rv = p.rivers[1]
	rv.halfWidth = nil
	rv.bedY = nil
	rv.curve = 1
	rv.meander = 30
	rv.widths = { 14, 18, 22, 26, 30, 34 }
	rv.bendWiden = 0.5
	rv.depths = { 8, 14, 30, 40, 20, 12 }
	rv.depthVary = 0.5
	rv.bedRough = 3
	rv.loops = { { leg = 3, radius = 60, turn = 290, side = "right" } }
	p.lakes = { { id = "lake", seed = 22, center = { -60, 740 }, radius = 120, shore = 60, warp = 20, elongate = 1.2, angle = 30, bedY = -40, depthVary = 0.4, bedRough = 4, waterLevel = 20 } }
	return p
end

